// Cache Coherence Stress Test Program (RV32I machine code)
// Designed for 4 cores accessing shared memory locations
// Each core writes its core_id to a shared location, then reads others' values
//
// Core 0: writes to Mem[0x1000], reads Mem[0x1004], [0x1008], [0x100C]
// Core 1: writes to Mem[0x1004], reads Mem[0x1000], [0x1008], [0x100C]
// Core 2: writes to Mem[0x1008], reads Mem[0x1000], [0x1004], [0x100C]
// Core 3: writes to Mem[0x100C], reads Mem[0x1000], [0x1004], [0x1008]
//
// All cores run the same program but use core_id to differentiate behavior

// Phase 1: Each core writes its ID to its designated slot
00100093  // ADDI x1, x0, 1       -> x1 = 1 (increment value)
00000113  // ADDI x2, x0, 0       -> x2 = 0 (counter)
10000193  // LUI  x3, 0x1         -> x3 = 0x1000 (base addr)

// Write core_id pattern (simplified: all write same locations)
00102023  // SW x1, 0(x0)          -> Mem[0] = 1
00202023  // SW x2, 0(x0)          -> Mem[0] = 0 (overwrite)
00102023  // SW x1, 0(x0)          -> Mem[0] = 1 (overwrite again)

// Phase 2: Read-modify-write (triggers MESI transitions)
00002203  // LW x4, 0(x0)         -> Read shared location
00120213  // ADDI x4, x4, 1       -> Increment
00402023  // SW x4, 0(x0)         -> Write back (M state)

// Phase 3: Cross-core reads (triggers S state)
00002283  // LW x5, 0(x0)         -> Read (may get S)
00402303  // LW x6, 4(x0)         -> Read adjacent line
00802383  // LW x7, 8(x0)         -> Read another line

// Phase 4: Write to cause invalidation
00102223  // SW x1, 4(x0)         -> Write to line others may share
00102423  // SW x1, 8(x0)         -> Another write

// Loop back (tight loop to keep cores busy)
00000013  // NOP
00000013  // NOP
FE000CE3  // BEQ x0, x0, -8      -> Infinite loop (branch to self-2)
00000013  // NOP
00000013  // NOP
00000013  // NOP
